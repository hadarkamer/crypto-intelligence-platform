.git
**/.git
**/node_modules
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/storage-state*.json
**/cookies*.json
**/*secret*
**/.DS_Store
**/*.log
**/dist
**/build
**/evidence
**/diagnostics
**/pgdata
**/browsers*
**/site-packages
**/*.zip
**/*.deb
**/*.tar
**/*.tar.gz
