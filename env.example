# Binance public market-data endpoint (no API key required)
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_PRICE_ENDPOINT=/api/v3/ticker/price
BINANCE_PRICE_TIMEOUT_SECONDS=15

# Binance USD-M Futures mark price (primary live price)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_MARK_ENDPOINT=/fapi/v1/premiumIndex

# Binance Spot fallback
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_PRICE_ENDPOINT=/api/v3/ticker/price
BINANCE_PRICE_TIMEOUT_SECONDS=15

# Automatic alert watch
WATCH_INTERVAL_MINUTES=30
# Closed 30m CVD publication grace: 2 minutes + 15 seconds by default.
WATCH_SYNC_GRACE_SECONDS=135
WATCH_DERIVATIVES_TIMEOUT_SECONDS=240
WATCH_DERIVATIVES_MAX_ATTEMPTS=3
WATCH_PRIORITY_THRESHOLD=70
WATCH_COOLDOWN_MINUTES=60

# Display-only filter: hide targets that are effectively reached.
MIN_DISPLAY_DISTANCE_PCT=0.8

# TradingView Shadow Mode ingestion
# Generate a long random value. It is sent inside the TradingView JSON body.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-long-random-secret

# HYPE live price fallback (official Hyperliquid public Info API)
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_PRICE_TIMEOUT_SECONDS=10

# HYPE fallback price sources
COINGECKO_SIMPLE_PRICE_URL=https://api.coingecko.com/api/v3/simple/price
COINGECKO_PRICE_TIMEOUT_SECONDS=10
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINPAPRIKA_PRICE_TIMEOUT_SECONDS=10

# CoinGlass V4 API (secret value belongs in Render, never in GitHub)
COINGLASS_API_KEY=

# Automatic rolling 3-day Price+OI historical refresh when 24h freshness is due
HISTORY_BACKFILL_INTERVAL_HOURS=24
HISTORY_BACKFILL_STARTUP_DELAY_SECONDS=60
HISTORY_BACKFILL_CHECK_INTERVAL_MINUTES=60
OI_BACKFILL_REQUEST_PAUSE_SECONDS=0.5
OI_BACKFILL_MAX_REQUEST_ATTEMPTS=4
